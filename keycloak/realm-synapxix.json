{
  "realm": "Synapxix",
  "enabled": true,
  "displayName": "Synapxix (desarrollo local)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self' http://localhost:4200 http://localhost:4201; object-src 'none';",
    "xFrameOptions": "",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xXSSProtection": "1; mode=block"
  },
  "roles": {
    "realm": [
      { "name": "teacher", "description": "Docente" },
      { "name": "student", "description": "Estudiante" },
      { "name": "director", "description": "Director" }
    ]
  },
  "clients": [
    {
      "clientId": "synapxix-app",
      "name": "Synapxix Web Game",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:4300/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4300",
        "http://localhost:4200"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4300/*+http://localhost:4200/*"
      }
    }
  ]
}
