generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["audit", "auth", "communication", "core", "dala", "knowledge", "psychometrics"]
}

model Institution {
  institution_id String      @id @default(uuid()) @db.Uuid
  name           String?     @db.VarChar(150)
  description    String?
  created_at     DateTime    @default(now())
  structures     Structure[]

  @@map("institution")
  @@schema("core")
}

model Structure {
  structure_id   String          @id @default(uuid()) @db.Uuid
  institution_id String          @db.Uuid
  name           String          @db.VarChar(150)
  parent_id      String?         @db.Uuid
  description    String?
  created_at     DateTime        @default(now())
  userStructures UserStructure[]
  institution    Institution     @relation(fields: [institution_id], references: [institution_id])
  parent         Structure?      @relation("StructureToParent", fields: [parent_id], references: [structure_id])
  children       Structure[]     @relation("StructureToParent")

  @@map("structure")
  @@schema("core")
}

model app_user {
  user_id           String                @id @default(uuid()) @db.Uuid
  username          String                @db.VarChar(150)
  email             String                @db.VarChar(150)
  firstname         String                @db.VarChar(150)
  lastname          String                @db.VarChar(150)
  role              String                @default("user") @db.VarChar(150)
  created_at        DateTime              @default(now())
  active            Boolean               @default(true)
  auditLogs         AuditLog[]
  sessions          Session[]
  linksFrom         UserLink[]            @relation("UserLinkFrom")
  linksTo           UserLink[]            @relation("UserLinkTo")
  userStructures    UserStructure[]
  notifications     Notification[]
  contentProgress   UserContentProgress[]
  credits           Int                   @default(0)
  experience_points Int                   @default(0)
  transactions      EconomyTransaction[]  @relation("UserToTransactions")
  gameSessions      GameSession[]         @relation("UserToGameSessions")
  cognitiveMetrics  CognitiveMetric[]     @relation("UserToMetrics")
  userProfile       UserProfile?
  
  inventory    UserInventory[]       @relation("UserToInventory")
  purchases    PurchaseTransaction[] @relation("UserToPurchases")
  
  @@map("app_user")
  @@schema("auth")
}

model EconomyTransaction {
  transaction_id  String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  game_session_id String   @unique @db.Uuid
  credits_awarded Int
  xp_awarded      Int      @default(0)
  reward_type     String   @default("GAME_VICTORY") @db.VarChar(50)
  created_at      DateTime @default(now())

  user        app_user    @relation("UserToTransactions", fields: [user_id], references: [user_id], onDelete: Cascade)
  gameSession GameSession @relation("TransactionToGameSession", fields: [game_session_id], references: [session_id], onDelete: Cascade)

  @@map("economy_transaction")
  @@schema("core")
}

model GameSession {
  session_id  String    @id @default(uuid()) @db.Uuid
  user_id     String?   @db.Uuid
  history_id  String    @db.VarChar(150)
  status      String    @default("playing") @db.VarChar(20)
  category    String?   @db.VarChar(50)
  started_at  DateTime  @default(now())
  finished_at DateTime?

  user               app_user?           @relation("UserToGameSessions", fields: [user_id], references: [user_id], onDelete: SetNull)
  attempts           GameAttempt[]
  economyTransaction EconomyTransaction? @relation("TransactionToGameSession")
  cognitiveMetrics   CognitiveMetric[]   @relation("SessionToMetrics")

  @@map("game_session")
  @@schema("core")
}

model GameAttempt {
  attempt_id        String   @id @default(uuid()) @db.Uuid
  session_id        String   @db.Uuid
  content_id        String   @db.VarChar(150)
  game_type         String   @db.VarChar(50)
  is_correct        Boolean
  score             Int
  completed_quickly Boolean?
  created_at        DateTime @default(now())

  session GameSession @relation(fields: [session_id], references: [session_id])

  @@map("game_attempt")
  @@schema("core")
}
model StoreItem {
  store_item_id String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(150)
  type          String   @db.VarChar(20)   // "avatar" | "banner"
  price         Int                         // en créditos virtuales
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  inventory     UserInventory[]
  purchases     PurchaseTransaction[]

  @@map("store_item")
  @@schema("core")
}

model UserInventory {
  inventory_id  String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  store_item_id String    @db.Uuid
  acquired_at   DateTime  @default(now())

  user          app_user  @relation("UserToInventory", fields: [user_id], references: [user_id], onDelete: Cascade)

  item          StoreItem @relation(fields: [store_item_id], references: [store_item_id], onDelete: Cascade)

  // Safety net contra concurrencia: solo 1 fila por (user, item)
  @@unique([user_id, store_item_id])
  @@map("user_inventory")
  @@schema("core")
}

model PurchaseTransaction {
  purchase_id    String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  store_item_id  String    @db.Uuid
  credits_spent  Int
  balance_before Int
  balance_after  Int
  created_at     DateTime  @default(now())

  user           app_user  @relation("UserToPurchases", fields: [user_id], references: [user_id], onDelete: Cascade)

  item           StoreItem @relation(fields: [store_item_id], references: [store_item_id], onDelete: Cascade)

  @@map("purchase_transaction")
  @@schema("core")
}

model UserLink {
  link_id      String    @id @default(uuid()) @db.Uuid
  id_user_from String?   @db.Uuid
  id_user_to   String?   @db.Uuid
  link_type    linkType
  created_at   DateTime  @default(now())
  userFrom     app_user? @relation("UserLinkFrom", fields: [id_user_from], references: [user_id])
  userTo       app_user? @relation("UserLinkTo", fields: [id_user_to], references: [user_id])

  @@unique([id_user_from, id_user_to, link_type])
  @@map("user_link")
  @@schema("auth")
}

model UserStructure {
  user_id      String    @db.Uuid
  structure_id String    @db.Uuid
  structure    Structure @relation(fields: [structure_id], references: [structure_id])
  user         app_user  @relation(fields: [user_id], references: [user_id])

  @@id([user_id, structure_id])
  @@map("user_structure")
  @@schema("auth")
}

model Session {
  session_id String    @id @default(uuid()) @db.Uuid
  user_id    String?   @db.Uuid
  token      String
  created_at DateTime  @default(now())
  expires_at DateTime
  user       app_user? @relation(fields: [user_id], references: [user_id])

  @@map("session")
  @@schema("auth")
}

model Dimension {
  dimension_id String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(150)
  description  String?
  archetypes   Archetype[] @relation("ArchetypeToDimension")

  @@map("dimension")
  @@schema("psychometrics")
}

model Archetype {
  archetype_id String     @id @default(uuid()) @db.Uuid
  dimension_id String?    @db.Uuid
  name         String     @db.VarChar(150)
  description  String?
  dimension    Dimension? @relation("ArchetypeToDimension", fields: [dimension_id], references: [dimension_id])

  @@map("archetype")
  @@schema("psychometrics")
}

model CognitiveMetric {
  metric_id        String   @id @default(uuid()) @db.Uuid
  session_id       String   @db.Uuid
  user_id          String?  @db.Uuid
  accuracy         Float
  reaction_time    Float
  cognitive_load   Float
  memory_retention Float?
  attention_span   Float?
  created_at       DateTime @default(now())

  session GameSession @relation("SessionToMetrics", fields: [session_id], references: [session_id], onDelete: Cascade)
  user    app_user?   @relation("UserToMetrics", fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("cognitive_metric")
  @@schema("psychometrics")
}

model Content {
  content_id      String                @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  prerequisite_id String?               @db.Uuid
  created_at      DateTime              @default(now())
  prerequisite    Content?              @relation("ContentPrerequisite", fields: [prerequisite_id], references: [content_id])
  prerequisites   Content[]             @relation("ContentPrerequisite")
  userProgress    UserContentProgress[]

  @@map("content")
  @@schema("knowledge")
}

model UserContentProgress {
  user_id     String   @db.Uuid
  content_id  String   @db.Uuid
  completed   Boolean  @default(false)
  progress    Float?
  last_update DateTime @default(now())
  content     Content  @relation(fields: [content_id], references: [content_id])
  user        app_user @relation(fields: [user_id], references: [user_id])

  @@id([user_id, content_id])
  @@map("user_content_progress")
  @@schema("knowledge")
}

model AuditLog {
  audit_id   String    @id @default(uuid()) @db.Uuid
  user_id    String?   @db.Uuid
  table_name String    @db.VarChar(100)
  record_id  String?   @db.Uuid
  timestamp  DateTime  @default(now())
  details    Json?
  user       app_user? @relation(fields: [user_id], references: [user_id])

  @@map("audit_log")
  @@schema("audit")
}

model Notification {
  notification_id String    @id @default(uuid()) @db.Uuid
  user_id         String?   @db.Uuid
  title           String    @db.VarChar(150)
  message         String?
  read            Boolean   @default(false)
  created_at      DateTime  @default(now())
  user            app_user? @relation(fields: [user_id], references: [user_id])

  @@map("notification")
  @@schema("communication")
}

enum linkType {
  STUDENT   @map("1")
  ASSISTANT @map("2")
  TEACHER   @map("3")
  DIRECTOR  @map("4")

  @@schema("auth")
}

model UserProfile {
  id            String   @id @default(uuid()) @db.Uuid
  theme         String   @default("dark") @db.VarChar(20)
  language      String   @default("es") @db.VarChar(10)
  notifications Boolean  @default(true)
  userId        String   @unique @map("user_id") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")

  user app_user @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@map("user_profile")
  @@schema("auth")
}

model AiPrompt {
  prompt_id  String   @id @default(uuid()) @db.Uuid
  game_type  String   @db.VarChar(50)
  category   String   @db.VarChar(50)
  name       String   @db.VarChar(150)
  content    String   @db.Text
  version    Int      @default(1)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([game_type, category, version])
  @@index([game_type, category, is_active])
  @@map("ai_prompt")
  @@schema("core")
}

// ═══════════════════════════════════════════════════════════════════════════
// D.A.L.A.™ — Bounded context propio. Schema lógico `dala`.
// Regla: ningún módulo de Synapxix escribe aquí directamente; todo pasa por
// la fachada del módulo dala. `psychometrics` queda para resultados
// psicométricos validados; NO es el núcleo D.A.L.A.
// ═══════════════════════════════════════════════════════════════════════════

model DalaInstrument {
  instrument_id      String   @id // p. ej. "categorization"
  instrument_version String
  description        String?
  payload_schema     Json? // JSON Schema del payload de sus eventos
  registered_at      DateTime @default(now())

  @@unique([instrument_id, instrument_version], map: "uq_instrument_version")
  @@map("instrument")
  @@schema("dala")
}

/// Append-only. Los eventos NUNCA se actualizan ni borran (correcciones = evento nuevo).
model DalaBehaviorEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  event_id           String   @unique @db.Uuid // idempotencia
  subject_id         String   @db.VarChar(64) // seudónimo, jamás user_id
  session_id         String   @db.Uuid
  event_type         String   @db.VarChar(50)
  sequence           Int
  occurred_at        DateTime // reloj del cliente
  recorded_at        DateTime @default(now()) // reloj del servidor
  instrument_id      String   @db.VarChar(100)
  instrument_version String   @db.VarChar(20)
  schema_version     String   @db.VarChar(40)
  context_json       Json
  payload_json       Json
  consent_scope      String   @db.VarChar(64)
  research_allowed   Boolean  @default(false)

  @@unique([session_id, sequence], map: "uq_session_sequence")
  @@index([subject_id, occurred_at])
  @@index([instrument_id, instrument_version])
  @@map("behavior_event")
  @@schema("dala")
}

/// Evidencia derivada: enlaza evento → regla (versionada) → constructo.
model DalaEvidenceObservation {
  observation_id          String   @id @default(uuid()) @db.Uuid
  subject_id              String   @db.VarChar(64)
  session_id              String   @db.Uuid
  source_event_id         String   @db.Uuid
  rule_id                 String   @db.VarChar(80)
  rule_version            String   @db.VarChar(20)
  construct_id            String   @db.VarChar(50)
  kind                    String   @db.VarChar(30)
  weight                  Float
  confidence_contribution Float
  observed_at             DateTime
  created_at              DateTime @default(now())

  @@index([subject_id, construct_id])
  @@index([source_event_id])
  @@map("evidence_observation")
  @@schema("dala")
}

/// Estimación vigente por (sujeto, constructo). El historial vive en snapshots.
model DalaConstructEstimate {
  id             String    @id @default(uuid()) @db.Uuid
  subject_id     String    @db.VarChar(64)
  construct_id   String    @db.VarChar(50)
  value          Float
  confidence     Float
  stability      Float
  status         String    @db.VarChar(30)
  uncertainty    Json
  evidence_count Int
  evidence_refs  Json
  valid_from     DateTime  @default(now())
  expires_at     DateTime?
  model_version  String    @db.VarChar(40)
  updated_at     DateTime  @updatedAt

  @@unique([subject_id, construct_id], map: "uq_subject_construct")
  @@map("construct_estimate")
  @@schema("dala")
}

/// Fotografía reproducible del HumanState con el rango de eventos que la produjo.
model DalaHumanStateSnapshot {
  snapshot_id       String   @id @default(uuid()) @db.Uuid
  subject_id        String   @db.VarChar(64)
  created_at        DateTime @default(now())
  state_json        Json
  source_event_from String   @db.Uuid
  source_event_to   String   @db.Uuid
  model_version     String   @db.VarChar(40)

  @@index([subject_id, created_at])
  @@map("human_state_snapshot")
  @@schema("dala")
}

/// Decisión inmutable con snapshot, política y razones (shadow mode en MVP).
model DalaDecisionRecord {
  decision_id             String   @id @default(uuid()) @db.Uuid
  subject_id              String   @db.VarChar(64)
  objective               String
  candidate_actions       Json
  selected_action         String   @db.VarChar(30)
  reasons                 Json
  state_snapshot_id       String   @db.Uuid
  policy_version          String   @db.VarChar(40)
  model_version           String   @db.VarChar(40)
  confidence              Float
  requires_human_approval Boolean  @default(true)
  expected_outcome        Json?
  human_verdict           String?  @db.VarChar(20) // approved | rejected | edited
  human_verdict_reason    String?
  created_at              DateTime @default(now())

  @@index([subject_id, created_at])
  @@map("decision_record")
  @@schema("dala")
}

/// Cierre del ciclo: efecto observado de una intervención.
model DalaOutcome {
  outcome_id      String   @id @default(uuid()) @db.Uuid
  decision_id     String   @db.Uuid
  intervention_id String   @db.VarChar(100)
  subject_id      String   @db.VarChar(64)
  metrics         Json
  observed_at     DateTime
  created_at      DateTime @default(now())

  @@index([decision_id])
  @@map("outcome")
  @@schema("dala")
}
