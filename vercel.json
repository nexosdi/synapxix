{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npx nx build team",
  "outputDirectory": "dist/team/browser",
  "regions": ["gru1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REEMPLAZAR-URL-DEL-SERVER.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
